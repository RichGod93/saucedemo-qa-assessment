	"item": [
		{
			"name": "POST Create User",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Generate unique username to avoid conflicts",
							"const timestamp = Date.now();",
							"const randomUsername = \"user\" + timestamp;",
							"",
							"pm.environment.set(\"username\", randomUsername);",
							"pm.environment.set(\"firstName\", \"Test\");",
							"pm.environment.set(\"lastName\", \"User\");",
							"pm.environment.set(\"email\", randomUsername + \"@test.com\");",
							"pm.environment.set(\"password\", \"testPass123\");",
							"",
							"console.log(\"Creating user: \" + randomUsername);"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test 1: Status code is 200",
							"pm.test(\"Status code is 200\", function() {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Test 2: Response time under 2000ms",
							"pm.test(\"Response time is less than 2000ms\", function() {",
							"    pm.expect(pm.response.responseTime).to.be.below(2000);",
							"});",
							"",
							"// Test 3: Response contains success code",
							"pm.test(\"Response indicates successful creation\", function() {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property(\"code\");",
							"    pm.expect(jsonData.code).to.be.a(\"number\");",
							"});",
							"",
							"// Test 4: Response contains message",
							"pm.test(\"Response contains message\", function() {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property(\"message\");",
							"});",
							"",
							"// Test 5: Response type is correct",
							"pm.test(\"Response has correct type\", function() {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property(\"type\");",
							"});",
							"",
							"console.log(\"User created: \" + pm.environment.get(\"username\"));"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "accept",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"id\": 0,\n  \"username\": \"{{username}}\",\n  \"firstName\": \"{{firstName}}\",\n  \"lastName\": \"{{lastName}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"phone\": \"1234567890\",\n  \"userStatus\": 1\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/user",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"user"
					]
				},
				"description": "Create a new user in the Petstore. Tests verify successful creation with 200 status, response structure, and timing."
			},
			"response": []
		},
