{
	"info": {
		"_postman_id": "qa-assessment-petstore-users",
		"name": "Petstore Users API Collection",
		"description": "API test collection for Swagger Petstore User endpoints as part of QA Technical Assessment. Tests include status code validation, response time, schema validation, authentication, and error handling for user management operations.\n\nBase API: https://petstore.swagger.io/v2",
